# Copy to .env (git-ignored) and fill in. Read by scripts/fetch_all.py only;
# keys never reach the browser.
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Optional (the Census API works without one at low volume): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
